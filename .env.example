# ========================================
# AWS Configuration (LocalStack for local dev)
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# ========================================
# S3 Configuration
# ========================================
S3_BUCKET_NAME=document-orchestrator-pdfs
S3_RESULTS_BUCKET=document-orchestrator-results

# ========================================
# DynamoDB Configuration
# ========================================
DYNAMODB_TABLE_NAME=DocumentOrchestrator
DYNAMODB_ENDPOINT=http://localhost:4566

# ========================================
# Kinesis Configuration
# ========================================
KINESIS_STREAM_NAME=document-processing-stream
KINESIS_ENDPOINT=http://localhost:4566

# ========================================
# LLM Provider Configuration
# ========================================
# Local: Gemini (requires API key)
# Production: Bedrock (uses IAM, no API key)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Production example:
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

SSM_PARAMETER_PATH=/document-orchestrator/development/

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
PORT=3005
FILE_SIZE_THRESHOLD_MB=0.5

# ========================================
# Reaper Configuration (Stuck Document Recovery)
# ========================================
REAPER_STUCK_THRESHOLD_MINS=30
REAPER_CRON_EXPRESSION=0 */5 * * * *
